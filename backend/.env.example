DATABASE_URL=postgresql://gymflow_mini:gymflow_mini@localhost:5434/gymflow_mini?schema=public
JWT_SECRET=replace_with_a_long_random_value
PORT=3100
CORS_ORIGIN=*
# En producción la verificación siempre se exige. En desarrollo puede activarse para probar el flujo.
EMAIL_VERIFICATION_REQUIRED=false
# ID de cliente OAuth 2.0 de tipo Aplicación web. Debe coincidir con
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID de la aplicación móvil.
GOOGLE_AUTH_CLIENT_ID=000000000000-ejemplo.apps.googleusercontent.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=soporte.gymflow@gmail.com
SMTP_PASSWORD=contraseña_de_aplicacion_de_16_caracteres
SMTP_FROM=GymFlow Mini <soporte.gymflow@gmail.com>
# En Render gratuito usa Mailjet por HTTPS. Para volver a Gmail SMTP usa MAIL_PROVIDER=smtp.
MAIL_PROVIDER=mailjet
MAILJET_API_KEY=reemplazar
MAILJET_SECRET_KEY=reemplazar
MAILJET_SENDER_EMAIL=soporte.gymflow@gmail.com
MAILJET_SENDER_NAME=GymFlow Mini
# Gmail API usa HTTPS y funciona en Render gratuito. Requiere OAuth 2.0 con acceso gmail.send.
# Para activarlo cambia MAIL_PROVIDER=gmail_api.
GMAIL_CLIENT_ID=reemplazar
GMAIL_CLIENT_SECRET=reemplazar
GMAIL_REFRESH_TOKEN=reemplazar
GMAIL_SENDER_EMAIL=soporte.gymflow@gmail.com
GMAIL_SENDER_NAME=GymFlow Mini
# Google Apps Script envía por HTTPS y evita la caducidad de OAuth en modo de prueba.
# Para activarlo cambia MAIL_PROVIDER=apps_script.
APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/reemplazar/exec
APPS_SCRIPT_SECRET=reemplazar
