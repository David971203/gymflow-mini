generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
}

enum GymSubscriptionPlan {
  TRIAL
  MONTHLY
  ANNUAL
}

enum SubscriptionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  SCHEDULED
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  OVERDUE
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  OTHER
}

enum AttendanceMethod {
  QR
  MANUAL
}

model Gym {
  id                    String               @id @default(uuid())
  name                  String
  slug                  String               @unique
  province              String?
  phone                 String?
  currency              String               @default("CUP")
  isActive              Boolean              @default(true)
  subscriptionPlan      GymSubscriptionPlan?
  subscriptionTrialDays Int                  @default(7)
  subscriptionStartedAt DateTime?
  subscriptionEndsAt    DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  users                 User[]
  members               Member[]
  plans                 Plan[]
  payments              Payment[]
  attendances           Attendance[]
  syncReceipts          SyncReceipt[]
  platformSubscriptions PlatformSubscription[]
  subscriptionRequests  SubscriptionRequest[]
  trialClaim            TrialClaim?
}

model SubscriptionRequest {
  id          String                    @id @default(uuid())
  code        String                    @unique
  gymId       String
  gym         Gym                       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  plan        GymSubscriptionPlan
  status      SubscriptionRequestStatus @default(PENDING)
  requestedAt DateTime                  @default(now())
  resolvedAt  DateTime?

  @@index([status, requestedAt])
  @@index([gymId, requestedAt])
}

model TrialClaim {
  id         String   @id @default(uuid())
  gymId      String?  @unique
  gym        Gym?     @relation(fields: [gymId], references: [id], onDelete: SetNull)
  phone      String   @unique
  deviceHash String   @unique
  claimedAt  DateTime @default(now())
}

model PlatformSubscription {
  id          String              @id @default(uuid())
  gymId       String
  gym         Gym                 @relation(fields: [gymId], references: [id], onDelete: Cascade)
  plan        GymSubscriptionPlan
  amount      Decimal             @db.Decimal(12, 2)
  startedAt   DateTime
  endsAt      DateTime
  activatedAt DateTime            @default(now())

  @@index([gymId, activatedAt])
  @@index([activatedAt])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  tokenVersion Int      @default(0)
  role         UserRole
  gymId        String?
  gym          Gym?     @relation(fields: [gymId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  movements          PaymentMovement[]
  syncReceipts       SyncReceipt[]
  passwordResetCodes PasswordResetCode[]

  @@index([gymId])
}

model PasswordResetCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Member {
  id             String       @id @default(uuid())
  gymId          String
  gym            Gym          @relation(fields: [gymId], references: [id])
  /// Carnet de identidad cubano. Se conserva como texto por los ceros iniciales.
  ci             String
  /// Código interno opcional asignado por cada gimnasio.
  code           String?
  firstName      String
  lastName       String
  age            Int?
  sex            String?
  phone          String?
  address        String?
  qrCode         String       @unique @default(uuid())
  status         MemberStatus @default(ACTIVE)
  joinedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  photoUpdatedAt DateTime?

  memberships Membership[]
  payments    Payment[]
  attendances Attendance[]
  photo       MemberPhoto?

  @@unique([gymId, ci])
  @@unique([gymId, code])
  @@index([gymId])
  @@index([status])
}

model MemberPhoto {
  memberId  String   @id
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gymId     String
  data      Bytes
  mimeType  String
  byteSize  Int
  updatedAt DateTime @updatedAt

  @@index([gymId])
}

model Attendance {
  id               String           @id @default(uuid())
  gymId            String
  gym              Gym              @relation(fields: [gymId], references: [id])
  memberId         String
  member           Member           @relation(fields: [memberId], references: [id])
  checkInAt        DateTime         @default(now())
  checkOutAt       DateTime?
  method           AttendanceMethod @default(MANUAL)
  clientCheckInId  String?          @unique
  clientCheckOutId String?          @unique
  createdAt        DateTime         @default(now())

  @@index([gymId, checkInAt])
  @@index([memberId, checkInAt])
}

model Plan {
  id           String   @id @default(uuid())
  gymId        String
  gym          Gym      @relation(fields: [gymId], references: [id])
  name         String
  description  String?
  price        Decimal  @db.Decimal(12, 2)
  durationDays Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]

  @@unique([gymId, name])
  @@index([gymId])
}

model Membership {
  id               String           @id @default(uuid())
  memberId         String
  member           Member           @relation(fields: [memberId], references: [id])
  planId           String
  plan             Plan             @relation(fields: [planId], references: [id])
  /// Condiciones inmutables del plan en el momento de contratar la membresía.
  planName         String
  planPrice        Decimal          @db.Decimal(12, 2)
  planDurationDays Int
  startDate        DateTime
  endDate          DateTime
  periodCount      Int              @default(1)
  status           MembershipStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  /// UUID de la operación offline que creó esta membresía.
  clientMutationId String?          @unique

  payment Payment?

  @@index([memberId, status])
  @@index([endDate])
}

model Payment {
  id           String        @id @default(uuid())
  gymId        String
  gym          Gym           @relation(fields: [gymId], references: [id])
  memberId     String
  member       Member        @relation(fields: [memberId], references: [id])
  membershipId String        @unique
  membership   Membership    @relation(fields: [membershipId], references: [id])
  amount       Decimal       @db.Decimal(12, 2)
  paidAmount   Decimal       @default(0) @db.Decimal(12, 2)
  dueDate      DateTime?
  status       PaymentStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  paidAt       DateTime?

  movements PaymentMovement[]

  @@index([gymId, status])
  @@index([memberId])
}

model PaymentMovement {
  id               String        @id @default(uuid())
  paymentId        String
  payment          Payment       @relation(fields: [paymentId], references: [id])
  actorUserId      String
  actor            User          @relation(fields: [actorUserId], references: [id])
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod
  reference        String?
  occurredAt       DateTime      @default(now())
  /// Hace idempotente un abono enviado varias veces durante la sincronización.
  clientMutationId String?       @unique

  @@index([paymentId])
  @@index([occurredAt])
}

model SyncReceipt {
  id          String   @id
  gymId       String
  gym         Gym      @relation(fields: [gymId], references: [id])
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id])
  type        String
  entityId    String
  status      String
  result      Json?
  message     String?
  createdAt   DateTime @default(now())

  @@index([gymId, createdAt])
}
