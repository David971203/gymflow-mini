{
  "expo": {
    "name": "GymFlow Mini",
    "slug": "gymflow-mini-admin",
    "version": "0.1.0",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.gymflow.mini.admin",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D8FF3F"
      }
    },
    "ios": {
      "bundleIdentifier": "com.gymflow.mini.admin",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "./assets/ios-icon.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a GymFlow Mini seleccionar una foto para el perfil del miembro.",
          "cameraPermission": "Permite a GymFlow Mini tomar una foto para el perfil del miembro.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permite a GymFlow Mini usar la cámara para escanear códigos QR y tomar fotos de los miembros.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#173F31",
          "defaultChannel": "membership-expirations"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5f1c8f5b-b6f9-4851-9cd4-5c9571c9d14a"
      }
    },
    "owner": "davidcuba29"
  }
}
