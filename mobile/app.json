{
  "expo": {
    "name": "GymFlow Mini",
    "slug": "gymflow-mini-admin",
    "version": "0.1.0",
    "platforms": [
      "android"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.gymflow.mini.admin",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#173f31"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#173F31",
          "defaultChannel": "membership-expirations"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5f1c8f5b-b6f9-4851-9cd4-5c9571c9d14a"
      }
    },
    "owner": "davidcuba29"
  }
}
